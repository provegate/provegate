{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate-tokens": {
      "inputs": ["src/tokens.ts", "scripts/generate-tokens.ts"],
      "outputs": ["src/tokens/colors.css", "src/cli/theme.ts"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsup.config.ts", "package.json"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"]
    }
  }
}
