{
  "name": "provegate-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ProveGate monorepo — CLI, landing page, and docs for the Gated Autonomy workflow",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss@<8.5.18": ">=8.5.18"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "prepare": "git config core.hooksPath .githooks",
    "check-egress": "node scripts/check-static-egress.mjs",
    "verify:brain": "node scripts/verify/verify-brain.mjs",
    "verify:review-artifact": "node scripts/verify/verify-review-artifact.mjs",
    "verify:durable-artifacts": "node scripts/verify/verify-durable-artifacts.mjs",
    "verify:deferred": "node scripts/verify/verify-deferred.mjs",
    "verify:test-task-coverage": "node scripts/verify/verify-test-task-coverage.mjs",
    "verify:gates-wired": "node scripts/verify/verify-gates-wired.mjs",
    "verify:dependency-audit": "node scripts/verify/verify-dependency-audit.mjs",
    "verify:workflow": "node scripts/verify/verify-workflow.mjs",
    "ship:pre": "node scripts/verify/verify-workflow.mjs && node -e \"console.log('ship:pre green — ready to push; run git push yourself (push is always human)')\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.5",
    "typescript-eslint": "^8.65.0"
  }
}
