{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emofy.local/schema/acceptances.schema.json",
  "title": "Operator Acceptance Store",
  "description": "Contract for _state/acceptances.json — owner-gated operator-acceptance entries written by `pnpm prd:accept` (PRD >= 248). Validated structurally by scripts/verify-acceptances.mjs (hand-rolled, no ajv). PRD-418.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acceptances"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "acceptances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceEntry"
      }
    }
  },
  "$defs": {
    "acceptanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prd", "owner", "items", "reason", "date", "method"],
      "properties": {
        "prd": {
          "type": "string",
          "pattern": "^PRD-[0-9]{3}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Must also be present in scripts/allowlists/acceptance-owners.json (checked by verify-acceptances.mjs; the allowlist is config, not schema)."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "How the acceptance was recorded, e.g. \"interactive\" or \"--yes\"."
        }
      }
    }
  }
}
