{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emofy.local/schemas/agent-lock.schema.json",
  "title": "Emofy Agent Workflow Lock",
  "type": "object",
  "required": [
    "schemaVersion",
    "lockId",
    "agent",
    "prd",
    "phase",
    "startedAt",
    "expiresAt",
    "touchedFiles"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1, 2]
    },
    "lockId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]+$"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "prd": {
      "type": "string",
      "pattern": "^PRD-[0-9]{3}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "Phase 1",
        "Phase 2",
        "Phase 2b",
        "Phase 3",
        "Phase 4",
        "Maintenance"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "touchedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Optional git branch the agent is working on (v2)."
    },
    "worktree": {
      "type": "string",
      "minLength": 1,
      "description": "Optional repo-relative worktree path (v2). Required when set: must start with `.worktrees/`."
    },
    "notes": {
      "type": "string"
    },
    "ownedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Optional glob patterns this PRD claims exclusive write-ownership of, for path-level conflict detection (v2, PRD-312). Doc-hygiene only — no ajv validator loads this schema; the runtime shape gate is verify-agent-locks (validateOwnedPaths), and verify:path-conflicts consumes this directly."
    }
  }
}
