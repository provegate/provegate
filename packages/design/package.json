{
  "name": "@provegate/design",
  "version": "0.0.0",
  "private": true,
  "description": "ProveGate design system — one token source for the terminal and the web.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./styles.css": "./src/styles.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/tokens",
    "assets"
  ],
  "scripts": {
    "generate-tokens": "tsx scripts/generate-tokens.ts",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [
    "provegate",
    "design-system",
    "tokens"
  ],
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
