{
  "name": "provegate",
  "version": "0.0.0",
  "description": "Gate autonomous AI coding on machine-checkable evidence. Prove it, then let it propagate.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "provegate": "./dist/cli.js",
    "gate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prompts",
    "templates",
    "schemas",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "gates",
    "verification",
    "evidence",
    "prd",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/provegate/provegate.git",
    "directory": "packages/provegate"
  },
  "homepage": "https://provegate.dev",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
